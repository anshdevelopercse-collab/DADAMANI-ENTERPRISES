PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/dada_mani_erp

# JWT Secrets
JWT_ACCESS_SECRET=dada_mani_enterprise_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=dada_mani_enterprise_refresh_secret_super_secure_key_2026
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d

# Email SMTP (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_user
SMTP_PASSWORD=your_brevo_smtp_password
SMTP_FROM=your_email@example.com
SMTP_FROM_NAME=Dada Mani Enterprise

# Security & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Admin Seed Account
DEFAULT_ADMIN_EMAIL=admin@dadamani.com
DEFAULT_ADMIN_PASSWORD=Admin@123456
